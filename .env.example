# Server Configuration
PORT=3001
FRONTEND_ORIGIN=http://localhost:5173

# Atlassian Cloud Credentials (Never exposed to the browser)
# Example: https://your-domain.atlassian.net
ATLASSIAN_BASE_URL=https://your-domain.atlassian.net
ATLASSIAN_EMAIL=developer@example.com
ATLASSIAN_API_TOKEN=your-atlassian-api-token

# Default Jira & Confluence Settings
# Supports both Confluence Folder ID and Page ID (e.g. https://baynext.atlassian.net/wiki/spaces/1KSGA/folder/5164335849/Technical+Design)
DEFAULT_JIRA_PROJECT_KEY=DEV
DEFAULT_CONFLUENCE_SPACE_KEY=1KSGA
DEFAULT_CONFLUENCE_PARENT_PAGE_ID=5164335849

# Google Gemini AI Configuration (Used for analyzing Jira updates before syncing to Confluence)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

